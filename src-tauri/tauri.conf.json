{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReZero Reading Archive",
  "version": "0.1.0",
  "identifier": "com.gustavo.rezerotracker",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Re:ゼロから始める異世界生活 — READING ARCHIVE",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
